# Re-export PhysioCore
import(PhysioCore)

# Compiled filtering kernels
useDynLib(PhysioPreprocess, .registration = TRUE)
importFrom(Rcpp, evalCpp)

# Filters
export(filterSignals)
export(butterworthFilter)
export(firFilter)
export(notchFilter)
export(detrendSignal)

# Causal / stateful filtering primitives
export(sosDesign)
export(sosfilt)
export(sosfiltInit)
export(sosfiltfilt)
export(lfilter)
export(lfilterInit)
export(StreamFilter)
S3method(print, StreamFilter)

# Resampling
export(resample)
export(decimate)
export(interpolate)
export(assaySamplingRates)
export(setAssaySamplingRate)

# Artifact detection and removal
export(icaDecompose)
export(icaRemove)
export(detectBadChannels)
export(interpolateBadChannels)
export(rejectBadEpochs)
export(baselineCorrect)
export(detectArtifacts)
export(classifyICAComponents)
export(cleanData)

# Artifact Subspace Reconstruction (ASR)
export(asrCalibrate)
export(asrProcess)
export(cleanRawdata)

# Line-noise removal (ZapLine / CleanLine)
export(zapLine)
export(cleanLine)

# ICA (new implementation)
export(runICA)
export(removeICAComponents)

# Detrending
export(detrendSignals)
export(removeBaseline)

# Re-referencing
export(rereference)
export(getCurrentReference)
export(isAverageReferenced)

# Preprocessing pipeline
export(createPipeline)
export(applyPipeline)
S3method(print, PhysioPipeline)

